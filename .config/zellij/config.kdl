// Zellij config — Catppuccin Mocha (maroon/mauve-Akzente, passend zu
// Hyprland-Bordern und kitty).
//
// Vim-Keybinds: die Zellij-Defaults sind bereits modal-vim —
//   Ctrl+p  -> Pane-Mode:   hjkl Fokus, r/d Split, x schließen, f Fullscreen
//   Ctrl+t  -> Tab-Mode:    h/l wechseln, n neu, x schließen
//   Ctrl+n  -> Resize-Mode: hjkl vergrößern, HJKL verkleinern
//   Ctrl+h  -> Move-Mode:   hjkl Pane verschieben
//   Ctrl+s  -> Scroll-Mode: j/k zeilenweise, d/u halbe Seite, / via s suchen,
//              e öffnet Scrollback in $EDITOR (nvim)
// Achtung: Alt+hjkl fängt bei uns Hyprland ab (Monitor-Wechsel), darum
// laufen alle Vim-Binds hier über die Modi. Defaults bleiben aktiv, unten
// stehen nur Ergänzungen.

theme "catppuccin-mocha-maroon"

default_shell "fish"
scrollback_editor "/usr/bin/nvim"
copy_command "wl-copy"

show_startup_tips false
show_release_notes false

ui {
    pane_frames {
        rounded_corners true
    }
}

keybinds {
    shared_except "locked" {
        // Splits ohne Modus-Umweg (Analog zu vim :sp / :vsp)
        bind "Alt d" { NewPane "down"; }
        bind "Alt r" { NewPane "right"; }
        // Tab-Wechsel ohne Modus (Alt+h/l gehören Hyprland, daher , und .)
        bind "Alt ," { GoToPreviousTab; }
        bind "Alt ." { GoToNextTab; }
    }
}

themes {
    catppuccin-mocha-maroon {
        // Palette: text cdd6f4, base 1e1e2e, surface0 313244, surface1 45475a,
        // surface2 585b70, crust 11111b, maroon eba0ac, mauve cba6f7,
        // red f38ba8, peach fab387, yellow f9e2af, green a6e3a1,
        // sky 89dceb, pink f5c2e7, teal 94e2d5, blue 89b4fa
        text_unselected {
            base 205 214 244
            background 30 30 46
            emphasis_0 250 179 135
            emphasis_1 137 220 235
            emphasis_2 166 227 161
            emphasis_3 245 194 231
        }
        text_selected {
            base 205 214 244
            background 49 50 68
            emphasis_0 250 179 135
            emphasis_1 137 220 235
            emphasis_2 166 227 161
            emphasis_3 245 194 231
        }
        ribbon_unselected {
