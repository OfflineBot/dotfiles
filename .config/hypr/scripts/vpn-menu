#!/usr/bin/env bash
# WireGuard-Toggle-Menü — läuft in einem floating kitty mit fzf.
# Aktive Tunnel kommen ohne Root von `ip link`; sudo braucht nur das
# Lesen von /etc/wireguard und das Schalten selbst (einmal Passwort,
# danach greift der sudo-Cache).

if [ "${1:-}" != "--tui" ]; then
    exec kitty --class menu-float --title "VPN" -e "$0" --tui
fi

pause_exit() { printf '\n%s\n' "$1"; read -r -n1 -p "Taste drücken zum Schließen ..."; exit "${2:-1}"; }

command -v wg-quick >/dev/null || pause_exit "wireguard-tools ist nicht installiert."

active=$(ip -br link show type wireguard 2>/dev/null | cut -d' ' -f1)

printf 'WireGuard — sudo-Passwort zum Lesen von /etc/wireguard:\n'
configs=$(sudo ls /etc/wireguard 2>/dev/null | sed -n 's/\.conf$//p')
[ -n "$configs" ] || pause_exit "Keine .conf-Dateien in /etc/wireguard gefunden."

menu=""
while IFS= read -r conf; do
    if grep -qx "$conf" <<< "$active"; then
        menu+=" ${conf} (connected)"$'\n'
    else
        menu+="󰌾 ${conf}"$'\n'
    fi
done <<< "$configs"

chosen=$(printf '%s' "$menu" | fzf --prompt="WireGuard> " --reverse --no-info) || exit 0
conf=$(sed 's/^[^ ]* //; s/ (connected)$//' <<< "$chosen")

if grep -qx "$conf" <<< "$active"; then
    sudo wg-quick down "$conf" \
        && notify-send "WireGuard" "Disconnected from ${conf}" -i network-vpn-symbolic \
        || pause_exit "wg-quick down ${conf} ist fehlgeschlagen."
else
    sudo wg-quick up "$conf" \
        && notify-send "WireGuard" "Connected to ${conf}" -i network-vpn-acquiring-symbolic \
        || pause_exit "wg-quick up ${conf} ist fehlgeschlagen."
fi
