cursor {
    xcursor-theme "catppuccin-mocha-dark-cursors"
    xcursor-size 24
}

input {
    focus-follows-mouse
    warp-mouse-to-focus mode="center-xy-always"
    keyboard {
        xkb {
            layout "us"
            options "compose:rctrl,lv3:ralt_switch"
            variant "altgr-intl"
        }
        numlock
        repeat-delay 600
        repeat-rate 25
    }
    touchpad {
        tap
        natural-scroll
        accel-profile "flat"
    }
    mouse {
        accel-speed -0.7
        accel-profile "flat"
    }
    tablet {
        map-to-output "DP-2"
    }
}

output "DP-2" {
    mode "2560x1440@180.002"
    scale 1
    transform "normal"
    position x=0 y=1080
}

output "DP-1" {
    mode "1920x1080@144.001"
    scale 1
    transform "normal"
    position x=0 y=0
}

output "DP-3" {
    mode "1280x1024@75.025"
    scale 1
    transform "normal"
    position x=2560 y=1580
}


layout {
    gaps 5
    struts {
        left 5
        right 5
        top 5
        bottom 5
    }
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#cba6f7"
        inactive-color "#585b70"
        urgent-color "#f38ba8"
    }

    border {
        off
        width 2
        active-color "#cba6f7"
        inactive-color "#585b70"
        urgent-color "#f38ba8"
    }

    background-color "#1e1e2e"
}

blur {
    passes 3
    offset 2.0
    noise 0.05
    saturation 0.8
}

overview {
    backdrop-color "#00000000"
}

window-rule {
    background-effect {
        blur true
        xray false
    }
    geometry-corner-radius 6
    clip-to-geometry true
}

window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id=r#"firefox$"#
    exclude title="^Picture-in-Picture$"
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id="xwaylandvideobridge"
    open-floating true
}

window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}

layer-rule {
    match namespace="^launcher$"
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^quickshell-bar$"
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^quickshell-clockpopup$"
    geometry-corner-radius 14
    background-effect {
        blur true
        xray false
    }
}
layer-rule {
    match namespace="^quickshell-network$"
    geometry-corner-radius 14
    background-effect {
        blur true
        xray false
    }
}
layer-rule {
    match namespace="^quickshell-launcher$"
    geometry-corner-radius 14
    background-effect {
        blur true
        xray false
    }
}
layer-rule {
    match namespace="^quickshell-tip$"
    geometry-corner-radius 8
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^quickshell-logout$"
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^notifications$"
    geometry-corner-radius 14
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace=r#"^awww-daemon\.backdrop$"#
    place-within-backdrop true
}

window-rule {
    match app-id="^menu-float$"
    open-floating true
    default-column-width { fixed 640; }
    default-window-height { fixed 400; }
}

// niri hat keinen Special-Workspace; "scratch" als benannter Workspace
// ist das Naechstbeste (Mod+Ctrl+S hin, Mod+Ctrl+A dorthin wechseln).
workspace "scratch"

// --- autostart ---------------------------------------------
spawn-at-startup "awww-daemon"
spawn-at-startup "sh" "-c" "awww-daemon --namespace .backdrop & sleep 0.4; awww img --namespace .backdrop $HOME/.cache/niri-wallpapers/eclipse-blur.jpg"
spawn-at-startup "quickshell"
spawn-at-startup "sh" "-c" "command -v wl-clip-persist >/dev/null && exec wl-clip-persist --clipboard regular"
spawn-at-startup "sh" "-c" "command -v cliphist >/dev/null && exec wl-paste --type text --watch cliphist store"
spawn-at-startup "sh" "-c" "command -v cliphist >/dev/null && exec wl-paste --type image --watch cliphist store"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "gtk-theme" "catppuccin-mocha-maroon-standard+default"
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "color-scheme" "prefer-dark"

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    DISPLAY ":0"
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 1.0

    window-open {
        duration-ms 200
        curve "ease-out-expo"
    }

    window-close {
        duration-ms 180
        curve "ease-out-quad"
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=600 epsilon=0.0001
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // --- apps ----------------------------------------------
    Mod+Q hotkey-overlay-title="Terminal: kitty" { spawn "kitty"; }
    Mod+Space hotkey-overlay-title="Launcher: quickshell" { spawn "qs" "ipc" "call" "launcher" "toggle"; }
    Mod+Shift+Space hotkey-overlay-title="Launcher: quickshell" { spawn "qs" "ipc" "call" "scriptlauncher" "toggle"; }
    Mod+W hotkey-overlay-title="Firefox" { spawn "firefox"; }
    Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }
    Mod+P hotkey-overlay-title="Pavucontrol" { spawn "pavucontrol"; }
    Mod+T hotkey-overlay-title="VPN menu" { spawn "sh" "-c" "$HOME/.config/hypr/scripts/vpn-menu"; }
    Mod+M hotkey-overlay-title="Logout (quickshell)" { spawn "qs" "ipc" "call" "logout" "toggle"; }
    Mod+R hotkey-overlay-title="Info panel (quickshell)" { spawn "sh" "-c" "qs ipc call topbar toggleClock \"$(niri msg --json focused-output | jq -r .name)\""; }
    Mod+B hotkey-overlay-title="Toggle topbar (quickshell)" { spawn "sh" "-c" "qs ipc call topbar toggle \"$(niri msg --json focused-output | jq -r .name)\""; }
    Mod+N hotkey-overlay-title="Lock: hyprlock" { spawn "hyprlock"; }

    // --- click burst ---------------------------------------
    F8 repeat=false hotkey-overlay-title="100 right clicks in 1s" { spawn "sh" "-c" "$HOME/.local/bin/autoclicker 100 0xC1 1"; }
    Shift+F8 repeat=false hotkey-overlay-title="100 left clicks in 1s" { spawn "sh" "-c" "$HOME/.local/bin/autoclicker 100 0xC0 1"; }

    // --- volume --------------------------------------------
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "0.1+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    // --- media ---------------------------------------------
    Alt+Q allow-when-locked=true hotkey-overlay-title="Music: previous track" { spawn "sh" "-c" "playerctl -l | grep -qi spotify && playerctl -p spotify previous || playerctl previous"; }
    Alt+W allow-when-locked=true hotkey-overlay-title="Music: play/pause" { spawn "sh" "-c" "playerctl -l | grep -qi spotify && playerctl -p spotify play-pause || playerctl play-pause"; }
    Alt+E allow-when-locked=true hotkey-overlay-title="Music: next track" { spawn "sh" "-c" "playerctl -l | grep -qi spotify && playerctl -p spotify next || playerctl next"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }

    // --- window management ---------------------------------
    Mod+C { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Alt+F { fullscreen-window; }
    Alt+Backslash { toggle-window-floating; }
    Mod+V { toggle-window-floating; }
    Mod+Ctrl+V hotkey-overlay-title="Clipboard history" { spawn "sh" "-c" "$HOME/.config/hypr/scripts/clipboard-menu"; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+G { toggle-column-tabbed-display; }

    // --- vim-style focus -----------------------------------
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+Tab { focus-window-down-or-column-right; }

    // --- move/swap window ----------------------------------
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down-or-to-workspace-down; }
    Mod+Shift+K { move-window-up-or-to-workspace-up; }

    // --- monitor focus -------------------------------------
    Alt+H { focus-monitor-left; }
    Alt+L { focus-monitor-right; }
    Alt+J { focus-monitor-down; }
    Alt+K { focus-monitor-up; }
    Alt+Shift+H { move-column-to-monitor-left; }
    Alt+Shift+L { move-column-to-monitor-right; }
    Alt+Shift+J { move-column-to-monitor-down; }
    Alt+Shift+K { move-column-to-monitor-up; }

    // --- overview ------------------------------------------
    Alt+Tab repeat=false { toggle-overview; }

    // --- workspaces ----------------------------------------
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // --- workspace navigation ------------------------------
    Mod+Ctrl+S { move-column-to-workspace "scratch"; }
    Mod+Ctrl+A { focus-workspace "scratch"; }

    Ctrl+Mod+H { move-column-to-workspace-up; }
    Ctrl+Mod+L { move-column-to-workspace-down; }

    // --- column/window sizing ------------------------------
    Mod+I { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+E { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // --- move floating window ------------------------------
    Ctrl+Shift+Up    { spawn "niri" "msg" "action" "move-floating-window" "-x" "0" "-y" "-50"; }
    Ctrl+Shift+Down  { spawn "niri" "msg" "action" "move-floating-window" "-x" "0" "-y" "50"; }
    Ctrl+Shift+Left  { spawn "niri" "msg" "action" "move-floating-window" "-x" "-50" "-y" "0"; }
    Ctrl+Shift+Right { spawn "niri" "msg" "action" "move-floating-window" "-x" "50" "-y" "0"; }

    // --- resize column/window ------------------------------
    Ctrl+Alt+Left  { set-column-width "-50"; }
    Ctrl+Alt+Right { set-column-width "+50"; }
    Ctrl+Alt+Up    { set-window-height "-50"; }
    Ctrl+Alt+Down  { set-window-height "+50"; }

    // --- screenshots ---------------------------------------
    Print { spawn "sh" "-c" "mkdir -p ~/Pictures/Screenshots && grim -g \"$(slurp)\" ~/Pictures/Screenshots/\"Screenshot from $(date '+%Y-%m-%d %H-%M-%S').png\""; }
    Shift+Print { spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy && notify-send -a Screenshot Screenshot 'Copied to clipboard'"; }
    Ctrl+Print { spawn "sh" "-c" "mkdir -p ~/Pictures/Screenshots && grim -o \"$(niri msg --json focused-output | jq -r .name)\" ~/Pictures/Screenshots/\"Screenshot from $(date '+%Y-%m-%d %H-%M-%S').png\""; }
    Alt+Print { screenshot-window; }
    Mod+Print { spawn "sh" "-c" "$HOME/.config/hypr/scripts/screenshot-menu.sh"; }
    Mod+Shift+Print { spawn "sh" "-c" "mkdir -p ~/Pictures/Screenshots && grim -g \"$(slurp)\" ~/Pictures/Screenshots/\"Screenshot from $(date '+%Y-%m-%d %H-%M-%S').png\""; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
}
